# Agentic Radar API (obs-management v2.0.0) — Variables de Entorno Requeridas
# Copia este archivo a .env (ignorado por Git) y rellena tus valores reales.

# Supabase (Proyecto unificado datalaria-core, esquema dedicado obs_radar)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# LLM para extracción semántica en CrewAI (nunca para cálculos financieros)
GEMINI_API_KEY=your-gemini-api-key
OBSOLESCENCE_LLM_MODEL=gemini/gemini-2.5-flash

# Seguridad de Webhooks POST (/api/v1/webhooks/*) — obligatorio al menos uno
WEBHOOK_HMAC_SECRET=replace-with-strong-hmac-sha256-secret
WEBHOOK_API_KEY=replace-with-strong-bearer-or-api-key

# CORS estricto separado por comas (prohibido '*' en producción)
ALLOWED_ORIGINS=https://datalaria.com,http://127.0.0.1:1313,http://localhost:1313

# Seeding protegido (ADR-014 / seeder_guard.py)
DEMO_USER_ID=18d01a19-450b-4099-96f4-66b21714a525
DEMO_USER_EMAIL=datalaria@gmail.com

# Notificaciones salientes opcionales
TEAMS_WEBHOOK_URL=
PORT=8001
